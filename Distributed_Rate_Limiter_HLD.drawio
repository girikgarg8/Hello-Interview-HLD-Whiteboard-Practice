    <mxGraphModel dx="2419" dy="1368" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Hello Interview Delivery Framework" vertex="1">
          <mxGeometry height="30" width="229" x="280" y="-91" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="1. Requirement Gathering (Functional and non functional)&lt;div&gt;2. Entity extraction&lt;/div&gt;&lt;div&gt;3. Client facing APIs or System interface&lt;/div&gt;&lt;div&gt;4. Data flow (only if data processing intensive question)&lt;/div&gt;&lt;div&gt;5. Basic HLD that satisfies functional requirements&lt;/div&gt;&lt;div&gt;6. Deep dive into non functional requirements&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="588" x="58" y="-47" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Requirement Gathering" vertex="1">
          <mxGeometry height="30" width="142" x="-46" y="86" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Functional" vertex="1">
          <mxGeometry height="30" width="60" x="-40" y="123" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. The system is able to identify requests based upon IP, user ID, API Key or similar identifiers" vertex="1">
          <mxGeometry height="30" width="558" x="-79" y="167" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. The system is able to rate limit requests based on the specified configuration" vertex="1">
          <mxGeometry height="30" width="558" x="-115" y="211" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="3. The configuration is dynamic in nature, and be changed later as required. (Example: update throttling limit from 100 to 200 TPS)" vertex="1">
          <mxGeometry height="30" width="731" x="-68" y="255" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-8" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Non functional&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="36" width="83" x="-46" y="370" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. CAP theorem: Availability &amp;gt;&amp;gt; Consistency. Example: if a configuration change is made, it is okay for the rate limiter to still serve requests with older configuration than going unavailable&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="837" x="-73" y="438" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. Low latency rate limit checks (&amp;lt;10 ms)" vertex="1">
          <mxGeometry height="30" width="495" x="-189" y="479" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="3. Scalable to handle 1Million TPS and 100M DAU" vertex="1">
          <mxGeometry height="30" width="692" x="-264" y="520" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="4. Feedback loop: Rate limiter should respond with number of allowed requests, reset time etc (through response headers)" vertex="1">
          <mxGeometry height="30" width="763" x="-100" y="298" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Entities" vertex="1">
          <mxGeometry height="30" width="60" x="-58" y="587" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Request" vertex="1">
          <mxGeometry height="30" width="60" x="-56" y="627" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Configuration/Rule" vertex="1">
          <mxGeometry height="30" width="110" x="141" y="621" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="- IP&lt;div&gt;- User ID&lt;/div&gt;&lt;div&gt;- API Key ?&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="96" width="73" x="-58" y="679" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="- MaxRequests&lt;div&gt;- TimeDuration&lt;/div&gt;&lt;div&gt;- Throttle Criteria (like IP, User ID etc)&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="130" x="121" y="692" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="API or System Interface" vertex="1">
          <mxGeometry height="30" width="154" x="-58" y="797" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-25" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Expressing it here as a function since rate limiter can be called via remote procedure call (RPC)" vertex="1">
          <mxGeometry height="30" width="279" x="-59" y="851" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-26" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="isRequestAllowed(clientId, ruleId) -&amp;gt; returns&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;div&gt;{passed: boolean, remaining: number, resetTime: timestamp }&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="383.5" x="-73" y="914" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="HLD&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="60" x="-61" y="1013" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Questions to answer which will influence the design:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. Where does rate limiter live in the system architecture?&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. How should we identify clients?&lt;/div&gt;" vertex="1">
          <mxGeometry height="113" width="281" x="-77" y="1102" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Different options of placing rate limiter along with tradeoffs explained&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="384" x="-144" y="1268" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-30" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Option 1: Each microservice having their own rate limiter" vertex="1">
          <mxGeometry height="30" width="364" x="-144" y="1311" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-31" edge="1" parent="1" source="1I7A6KjD0a8kr-Q23iSR-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;innerLoopWaypoints=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="1I7A6KjD0a8kr-Q23iSR-30">
