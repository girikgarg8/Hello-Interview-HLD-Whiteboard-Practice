        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-33" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="API Gateway" vertex="1">
          <mxGeometry height="60" width="120" x="91" y="1461" as="geometry" />
        </mxCell>
        <mxCell id="1I7A6KjD0a8kr-Q23iSR-34" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;Microservice 1" vertex="1">
          <mxGeometry height="60" width="120" x="340" y="1376" as="geometry" />
        </mxCell>
