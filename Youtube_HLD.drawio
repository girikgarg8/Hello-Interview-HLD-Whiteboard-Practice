          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="527" y="3953" as="sourcePoint" />
            <mxPoint x="496" y="4166" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YNMJSUh1zJjP1P0iry2Z-115" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Lambda function: update status of client side chunk" vertex="1">
          <mxGeometry height="30" width="60" x="530" y="4005" as="geometry" />
        </mxCell>
        <mxCell id="YNMJSUh1zJjP1P0iry2Z-116" edge="1" parent="1" source="YNMJSUh1zJjP1P0iry2Z-110" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="738" y="3901" as="sourcePoint" />
            <mxPoint x="830.29" y="3931.57" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YNMJSUh1zJjP1P0iry2Z-117" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Lambda function: server side chunking of 5-10 sec each" vertex="1">
          <mxGeometry height="30" width="60" x="639" y="3901" as="geometry" />
        </mxCell>
        <mxCell id="YNMJSUh1zJjP1P0iry2Z-118" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Transcoder: 144p" vertex="1">
          <mxGeometry height="60" width="120" x="829" y="3905" as="geometry" />
        </mxCell>
        <mxCell id="YNMJSUh1zJjP1P0iry2Z-119" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Transcoder: 1080 p" vertex="1">
          <mxGeometry height="60" width="120" x="819" y="4028" as="geometry" />
        </mxCell>
        <mxCell id="YNMJSUh1zJjP1P0iry2Z-120" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="YNMJSUh1zJjP1P0iry2Z-119" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="741.71" y="4060.86" />
            </Array>
            <mxPoint x="741.71" y="3929.43" as="sourcePoint" />
