          </mxGeometry>
        </mxCell>
        <mxCell id="YNMJSUh1zJjP1P0iry2Z-121" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;entryX=0.685;entryY=-0.014;entryDx=0;entryDy=0;entryPerimeter=0;" target="YNMJSUh1zJjP1P0iry2Z-110" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="908.86" y="3782.29" />
              <mxPoint x="534.57" y="3782.29" />
            </Array>
            <mxPoint x="903.14" y="3903.71" as="sourcePoint" />
            <mxPoint x="1025" y="3776" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YNMJSUh1zJjP1P0iry2Z-122" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. Put 144p server side chunk into S3&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. Update manifest.json in S3&lt;/div&gt;" vertex="1">
          <mxGeometry height="127" width="111.5" x="664.5" y="3579" as="geometry" />
        </mxCell>
        <mxCell id="YNMJSUh1zJjP1P0iry2Z-123" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="CDN to store manifest as well as video segments (chunks)" vertex="1">
          <mxGeometry height="60" width="120" x="-168" y="3878" as="geometry" />
        </mxCell>
        <mxCell id="YNMJSUh1zJjP1P0iry2Z-124" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="There will be logic on client side which will assess the network conditions periodically.&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Initially the network bandwith might be high but if the conditions worsen, then the player can start streaming the 144p segment instead of 720p&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="1130" x="-274" y="4374" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
