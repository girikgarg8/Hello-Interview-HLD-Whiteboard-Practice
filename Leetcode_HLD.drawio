        <mxCell id="SbvYTmW74KeEhvhrWvDF-40" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Submission&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Id&lt;/div&gt;&lt;div&gt;- UserId&lt;/div&gt;&lt;div&gt;- TestCaseResults[]&lt;/div&gt;&lt;div&gt;- Status&lt;/div&gt;&lt;div&gt;- Score&lt;/div&gt;&lt;div&gt;- ContestId?&lt;/div&gt;&lt;div&gt;&amp;nbsp;- MemoryConsumption&lt;/div&gt;&lt;div&gt;- TimeForExecution&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;etc&lt;/div&gt;" vertex="1">
