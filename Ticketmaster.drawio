          <mxGeometry height="30" width="60" x="-139" y="336" as="geometry" />
        </mxCell>
        <mxCell id="82d1D_E5-_z6WtIXFdai-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. User is able to search for events based on search criteria like performer, venue, date etc and see all the available options" vertex="1">
          <mxGeometry height="30" width="360" x="-139" y="399" as="geometry" />
        </mxCell>
        <mxCell id="82d1D_E5-_z6WtIXFdai-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="3. User is able to book ticket for a specific event" vertex="1">
          <mxGeometry height="30" width="360" x="-183" y="526" as="geometry" />
        </mxCell>
        <mxCell id="82d1D_E5-_z6WtIXFdai-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. User is able to view details of a specific event" vertex="1">
          <mxGeometry height="30" width="360" x="-183" y="465" as="geometry" />
        </mxCell>
        <mxCell id="82d1D_E5-_z6WtIXFdai-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Non-functional" vertex="1">
          <mxGeometry height="30" width="145" x="-162" y="587" as="geometry" />
        </mxCell>
        <mxCell id="82d1D_E5-_z6WtIXFdai-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. CAP Theorem: AP for event search and creation part, CP for booking flow since we don&#39;t want double booking scenarios&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. Low latency search (&amp;lt;500 ms)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3. Scalable to handle surges from popular events&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;4. Read &amp;gt;&amp;gt; Write: Read heavy system: Lot of folks would be searching for events, but fewer of them would be booking tickets. This gives opportunities for CQRS, caching and DB indexes&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="429" x="-127" y="642" as="geometry" />
        </mxCell>
        <mxCell id="82d1D_E5-_z6WtIXFdai-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Entity extraction and API design" vertex="1">
