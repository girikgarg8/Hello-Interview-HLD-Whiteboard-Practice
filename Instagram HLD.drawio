          </mxGeometry>
        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-63" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="4.1 Write precomputed feed entries" vertex="1">
          <mxGeometry height="30" width="60" x="629" y="2477" as="geometry" />
        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-64" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Precomputed Feed&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Id&lt;/div&gt;&lt;div&gt;- UserId (index)&lt;/div&gt;&lt;div&gt;- PostId&lt;/div&gt;" vertex="1">
          <mxGeometry height="93" width="120" x="945" y="2312" as="geometry" />
        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-65" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Follow&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Id&lt;/div&gt;&lt;div&gt;- FollowerUserId (Index)&lt;/div&gt;&lt;div&gt;- FollowedUserId (Index)&lt;/div&gt;" vertex="1">
          <mxGeometry height="93" width="162" x="1161" y="2312" as="geometry" />
        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-66" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Notes on the write and read paths for precomputed feed:" vertex="1">
          <mxGeometry height="30" width="213" x="344" y="2825" as="geometry" />
        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-67" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Write path:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Whenever a new post is created,&amp;nbsp; push an event to Kafka topic, which will be consumed by a Kafka consumer&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;This Kafka consumer will look at the author of post, and how many followers this author has.&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="326" x="247" y="2929" as="geometry" />
        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-69" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="A. If number of followers &amp;lt; 10,000 (non-celebrity):&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Create a precomputed feed entry for follow to author&#39;s post ID&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;B. If number of followers &amp;gt; 10,000 (celebrity):&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Drop the event. No precomputed feed entry will be persisted to DB.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="109" width="283" x="274" y="3083" as="geometry" />
        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-70" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Why?" vertex="1">
          <mxGeometry height="30" width="60" x="377" y="3217" as="geometry" />
        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-71" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="A celebrity can have millions of followers&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Creating precomputed feed for millions of followers will be computationally and monetarily expensive&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="303" x="264" y="3277" as="geometry" />
        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-72" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Read path:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;When a user logs in to view their feed, we&#39;ll use a combination of the two techniques:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;A. Fan out on write: Read the precomputed feed entries from DB, download the media from CDN/S3 and display to user&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;B.&amp;nbsp; Fan out on read path:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Parallely, for the celebrity posts&#39; usecase, search all the followers of current logged in user, and fetch posts of all the celebrities.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;These posts can be lazily displayed to the user once they scroll down to fetch the next set of posts.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="201" width="183.5" x="289.5" y="3395" as="geometry" />
        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-73" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;entryX=0.006;entryY=0.442;entryDx=0;entryDy=0;entryPerimeter=0;" target="d20bjUF1XWa1bvxXcyLc-30" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-621" y="2358" as="sourcePoint" />
            <mxPoint x="-571" y="2308" as="targetPoint" />
          </mxGeometry>
        </mxCell>
