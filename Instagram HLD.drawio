        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-51" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="You request different byte ranges of a single unified object to stream multiple pieces over separate network channels simultaneously. Your download client writes these streams directly into their designated positions on disk, naturally reassembling the file without needing a post-download merge step." vertex="1">
          <mxGeometry height="30" width="421" x="-971" y="3056" as="geometry" />
        </mxCell>
