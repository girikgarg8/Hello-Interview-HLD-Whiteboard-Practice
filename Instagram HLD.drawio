          <mxGeometry height="30" width="157" x="482" y="2222" as="geometry" />
        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-54" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Note:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. Media transcoding (converting to different formats like 144p, 360p, 1080 p) hasn&#39;t been shown in the diagram to keep it less cluttered.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;However, note that:&lt;br&gt;&lt;br&gt;A. You do not need to write your own transcoder, as third-party services like Cloudinary, AWS Elemental MediaConvert, and Mux can handle video and image transcoding entirely for you.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;B. After transcoding, store all the different format of chunk in a manifest file.&lt;br&gt;&lt;br&gt;C. The client can then read the mannifest file and download the appropriate resolution (144p/1080p) according to the network bandwidth.&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="166" x="-140" y="3013" as="geometry" />
        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-55" edge="1" parent="1" source="d20bjUF1XWa1bvxXcyLc-31" style="endArrow=classic;html=1;rounded=0;exitX=0.579;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.445;entryY=0.123;entryDx=0;entryDy=0;entryPerimeter=0;" target="d20bjUF1XWa1bvxXcyLc-58" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-125" y="2407" as="sourcePoint" />
            <mxPoint x="313.45" y="2485.68" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-56" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="4.0 Async &#39;post event&#39;&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="183.5" x="184" y="2375" as="geometry" />
        </mxCell>
