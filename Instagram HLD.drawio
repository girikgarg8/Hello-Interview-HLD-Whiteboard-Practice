          </mxGeometry>
        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-61" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Kafka consumer" vertex="1">
          <mxGeometry height="36" width="120" x="478" y="2486" as="geometry" />
        </mxCell>
        <mxCell id="d20bjUF1XWa1bvxXcyLc-62" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="d20bjUF1XWa1bvxXcyLc-40" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
