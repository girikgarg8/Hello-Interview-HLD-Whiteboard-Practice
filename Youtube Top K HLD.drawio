        <mxCell id="e2RgB2zIPSqEstAvz9yk-130" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="VideoViewAllTime table&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Video&lt;/div&gt;&lt;div&gt;- Views&lt;/div&gt;" vertex="1">
