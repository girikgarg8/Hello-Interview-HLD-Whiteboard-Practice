        <mxCell id="e2RgB2zIPSqEstAvz9yk-103" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Q. What are the ways to avoid such huge aggregation of data that we did in step A ?&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="459" x="-1173" y="5653" as="geometry" />
        </mxCell>
        <mxCell id="e2RgB2zIPSqEstAvz9yk-104" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Option 1" vertex="1">
          <mxGeometry height="30" width="60" x="-1173" y="5712" as="geometry" />
        </mxCell>
        <mxCell id="e2RgB2zIPSqEstAvz9yk-105" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Use Hadoop or Spark Jobs. Each job can take up the job of aggregation of a specific video, which helps us to parallelize the aggregation process.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Once done, the aggregated monthly view data from each job can be sorted&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Downside:&amp;nbsp; We&#39;ll be using lot of resources for a problem that can be solved with lesser resources elegantly&lt;/div&gt;" vertex="1">
          <mxGeometry height="106" width="422" x="-1185" y="5778" as="geometry" />
        </mxCell>
        <mxCell id="e2RgB2zIPSqEstAvz9yk-106" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Option 2" vertex="1">
          <mxGeometry height="30" width="60" x="-1180" y="5949" as="geometry" />
        </mxCell>
        <mxCell id="e2RgB2zIPSqEstAvz9yk-108" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Create different tables to store view data at different granularities (hourly, daily, monthly, all time) at the write path&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;This will benefit during the read path, if top K videos over a month have to be fetched, the sum count of views of each video is already present in the table. We don&#39;t have to do the aggregation, how we were doing in step A of option 1 earlier.&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="373" x="-1183" y="6062" as="geometry" />
        </mxCell>
        <mxCell id="e2RgB2zIPSqEstAvz9yk-110" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Updated HLD after option 2:" vertex="1">
          <mxGeometry height="30" width="167.5" x="-1180" y="6175" as="geometry" />
        </mxCell>
