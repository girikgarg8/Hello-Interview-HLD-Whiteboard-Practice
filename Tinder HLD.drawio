    <mxGraphModel dx="2053" dy="954" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="_zuop-OibEd9gmZE1kWI-1" parent="1" style="whiteSpace=wrap;html=1;" value="Hello Interview Delivery Framework&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. Requirement Gathering (Functional and non-functional)&lt;/div&gt;&lt;div&gt;2. Entity extraction and API design&lt;/div&gt;&lt;div&gt;3. Data flow (applicable if infra heavy question)&lt;/div&gt;&lt;div&gt;4. HLD that satisfies basic functional requirements&lt;/div&gt;&lt;div&gt;5. Deep dive into non functional requirements&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="173" width="375" x="225" y="36" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Functional requirements" vertex="1">
          <mxGeometry height="30" width="167" x="-204" y="325" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. Users can set their preference (age, gender etc)" vertex="1">
          <mxGeometry height="30" width="558" x="-331" y="382" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. Users can view a stack of potential matches&lt;div&gt;- match preferences&lt;/div&gt;&lt;div&gt;- close to current location&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="526" x="-326" y="432" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="3. Users are able to swipe left (dislike) and right (like) for each of the potential matches&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="526" x="-218" y="492" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="4. When two users swipe right to each other, they are notified about it" vertex="1">
          <mxGeometry height="30" width="526" x="-270" y="533" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Non-functional requirements" vertex="1">
          <mxGeometry height="30" width="167" x="-195" y="764" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. CAP theorem:&amp;nbsp; AP for profile signup and lookup, however CP for swipes (making swipes AP would make the problem significantly easier but the intent of problem is to make it challenging)" vertex="1">
          <mxGeometry height="30" width="599" x="-199" y="825" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. Low latency feed load with suggestions (&amp;lt;300 ms)" vertex="1">
          <mxGeometry height="30" width="426" x="-261" y="895" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="3. Instant notification when two users swipe right to each other" vertex="1">
          <mxGeometry height="30" width="316" x="-197" y="948" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Out of scope functional requirements" vertex="1">
          <mxGeometry height="30" width="227" x="-204" y="608" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="• Creating a full profile" vertex="1">
          <mxGeometry height="30" width="183" x="-220" y="659" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="4. Scale of system:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;10 M DAU&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;On an average, each person might swipe left or right on 100 profiles. Hence, ability to handle write throughput of 10M*100 swipes a day&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="103" width="308.5" x="-206.25" y="1001" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Entities extraction and API design" vertex="1">
          <mxGeometry height="30" width="213" x="-213" y="1164" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="• Profile&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Id&lt;/div&gt;&lt;div&gt;- AgePreference&lt;/div&gt;&lt;div&gt;- GenderPreference&lt;/div&gt;&lt;div&gt;...other metadata&lt;/div&gt;" vertex="1">
          <mxGeometry height="109" width="150" x="-223" y="1226" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-18" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Swipe&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Id&lt;/div&gt;&lt;div&gt;- SenderUserId&lt;/div&gt;&lt;div&gt;- ReceiverUserId&lt;/div&gt;&lt;div&gt;- Type: Dislike| Like&lt;/div&gt;&lt;div&gt;...other metadata&lt;/div&gt;" vertex="1">
          <mxGeometry height="103" width="136" x="7" y="1232" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-19" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Match&lt;/div&gt;&lt;div&gt;- Id&lt;/div&gt;&lt;div&gt;- User1Id&lt;/div&gt;&lt;div&gt;- User2Id&lt;/div&gt;&lt;div&gt;...other metadata&lt;/div&gt;" vertex="1">
          <mxGeometry height="103" width="60" x="252" y="1235" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="API design" vertex="1">
          <mxGeometry height="30" width="112" x="-230" y="1376" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-22" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="POST /profiles&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;MinAgePreference&amp;nbsp; MaxAgePreference&lt;/div&gt;&lt;div&gt;GenderPreference&lt;/div&gt;&lt;div&gt;....&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="124" width="60" x="-216" y="1438" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-23" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="GET /matches?distance={5km}&amp;amp;latitude={latitude}&amp;amp;longitude={longitude}" vertex="1">
          <mxGeometry height="30" width="60" x="25" y="1432" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-25" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="User ID from authentication header JWT/session&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="123" x="-4" y="1517" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-26" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Return:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;List &amp;lt;Profile&amp;gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="35" y="1614" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="POST /swipes&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="136" x="231" y="1410" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="User ID from authentication header JWT/session&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="123" x="227" y="1445" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;{&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;ReceivingUserId&lt;/div&gt;&lt;div&gt;Type: Like | Dislike&lt;/div&gt;&lt;div&gt;....&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="124" width="119" x="252" y="1509" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-30" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Returns: Profile" vertex="1">
          <mxGeometry height="30" width="60" x="-219" y="1595" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-31" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="HLD" vertex="1">
          <mxGeometry height="30" width="141" x="-286" y="1762" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-32" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Two possible choices - keep the swipes as eventually consistent (AP) or strongly consistent (CP)" vertex="1">
          <mxGeometry height="30" width="309" x="-9" y="1830" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-34" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="_zuop-OibEd9gmZE1kWI-35" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="106.59" y="1875" as="sourcePoint" />
            <mxPoint x="8.409999999999997" y="1926.8200000000002" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-35" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="AP&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Choice of DB: Cassandra&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Pros:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. Each Cassandra Node can handle high througput, thus even at scale of 100M*100 TPS, the overall number of nodes required would be less. Cost efficient solution&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. According to real life constraint too, AP nature fits the swipe more. There is no reason to have strong read after write consistency for swipes.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Cons:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. Let&#39;s say A does right swipe to B at t=0 and B does right swipe to A at t=1, during the write, when we check whether the inverted swap exists or not, due to eventual consistent nature it might not exist. Thus, there is a risk of losing these matches.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;a. We can introduce a reconciliation workflow (cron job), which checks for these swipes and inverted swipes and notifies the users accordingly. Not realtime though.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. Interviewer might force to make swipes strictly consistent, in which case we have no other choice&lt;/div&gt;" vertex="1">
          <mxGeometry height="748" width="158" x="-133" y="1978" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-36" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;entryX=0.39;entryY=-0.004;entryDx=0;entryDy=0;entryPerimeter=0;" target="_zuop-OibEd9gmZE1kWI-37" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="105.9" y="1874.33" as="sourcePoint" />
            <mxPoint x="193.52" y="1964.81" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="CP&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Choice of DB: Postgres&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Pros:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. At realtime, we can check whether the inverted swipe exists or not with strict data consistency. And then send realtime notifications to users informing them of the match.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. Satisfies the CP nature originally highlighted in non functional requirements&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Cons:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. Each Postgres node can handle lower throughput compared to Cassanra node. This means, we need more nodes to handle the throughput making it a costlier solution.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. The data model/schema with Postgres is slightly unintuitive compared to the case if we were able to support it with Cassandra&lt;/div&gt;" vertex="1">
          <mxGeometry height="560" width="158" x="151" y="2010" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-38" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Q. What makes Cassandra have so much write throughput per node compared to Postgres?" vertex="1">
          <mxGeometry height="30" width="527" x="-211" y="2742" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-39" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="A. Short summary: In Cassandra, each write is simply appended to end of file.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;While for Postgres, we first need to find the right page and then write data.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Detailed answer:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;• Cassandra write flow&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Write to a log (disk)&lt;/div&gt;&lt;div&gt;- Write to in memory memtable&lt;/div&gt;&lt;div&gt;- Senf successful ACK to client confirming the write&lt;/div&gt;&lt;div&gt;- Periodically, flush memory to disk&lt;/div&gt;&lt;div&gt;- Write is just an append to a file&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;• Postgres write flow&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-&amp;nbsp; Write log WAL (disk)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- Do the DB write (disk)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- Seeking to right spot and changing or adding row&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="372" width="513" x="-235" y="2799" as="geometry" />
        </mxCell>
        <mxCell id="_zuop-OibEd9gmZE1kWI-40" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="System design with Cassandra (AP) for swipes" vertex="1">
          <mxGeometry height="30" width="319" x="-311" y="3198" as="geometry" />
        </mxCell>
