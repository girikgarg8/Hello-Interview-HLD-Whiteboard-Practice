        <mxCell id="iIfmfWo0CBsvGYO34Th3-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. User should be to send and receive text messages to other users&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3. User should be able to send and receive media (images, videos etc) to other users&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;4. Users should be able to access message after they have been offline&lt;/div&gt;" vertex="1">
          <mxGeometry height="131" width="211" x="-167" y="429" as="geometry" />
        </mxCell>
        <mxCell id="iIfmfWo0CBsvGYO34Th3-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. Users can start group chats as well as converse over DM" vertex="1">
          <mxGeometry height="30" width="194" x="-165" y="389" as="geometry" />
        </mxCell>
        <mxCell id="iIfmfWo0CBsvGYO34Th3-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Non-functional requirements" vertex="1">
