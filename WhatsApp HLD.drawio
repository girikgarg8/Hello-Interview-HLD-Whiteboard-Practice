        </mxCell>
        <mxCell id="iIfmfWo0CBsvGYO34Th3-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. Messages are delivered with low latency (&amp;lt;500 ms, with this number we have sufficient margin for offline usecase too)" vertex="1">
          <mxGeometry height="30" width="304" x="-181" y="701" as="geometry" />
        </mxCell>
        <mxCell id="iIfmfWo0CBsvGYO34Th3-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="3. System should guarantee delivery of messages" vertex="1">
          <mxGeometry height="30" width="309.5" x="-200" y="764" as="geometry" />
