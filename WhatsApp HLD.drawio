        <mxCell id="iIfmfWo0CBsvGYO34Th3-49" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="In our case, we require low latency, bidirectional communication with no video/audio calling&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Hence, Websocket is the way to go for&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="494" x="-191" y="1883" as="geometry" />
        </mxCell>
        <mxCell id="iIfmfWo0CBsvGYO34Th3-51" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="There really is no standard way to describe WebSocket APIs, unlike REST architecture&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;However, we&#39;ll be describing them in the form of commands sent (sent by client to server) and commands received (received from client by server) along with their payloads&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="410" x="-201" y="2024" as="geometry" />
