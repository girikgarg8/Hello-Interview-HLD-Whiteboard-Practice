        <mxCell id="iIfmfWo0CBsvGYO34Th3-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="4. Scale to handle billions of users, system will have high throughput" vertex="1">
