        <mxCell id="iIfmfWo0CBsvGYO34Th3-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Hello Interview delivery framework&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. Requirement Gathering (functional and non-functional)&lt;/div&gt;&lt;div&gt;2. Entity extraction and API design&lt;/div&gt;&lt;div&gt;3. Data flow (if infra heavy question)&lt;/div&gt;&lt;div&gt;4. HLD that satisfies basic functional requirements&lt;/div&gt;&lt;div&gt;5. Deep dives into non functional requirements&lt;/div&gt;" vertex="1">
          <mxGeometry height="159" width="334" x="232" y="74" as="geometry" />
        </mxCell>
        <mxCell id="iIfmfWo0CBsvGYO34Th3-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Functional requirements" vertex="1">
