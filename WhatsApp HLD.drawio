        <mxCell id="iIfmfWo0CBsvGYO34Th3-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. CAP theorem: AP system (Eventual consistency is fine)" vertex="1">
