<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="FxnuOfmPRmIRRlKsC35o">
    <mxGraphModel dx="1678" dy="764" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Hello Interview Delivery Framework" vertex="1">
          <mxGeometry height="30" width="247" x="222" y="43" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="1. Requirement Gathering (Functional and non functional)&lt;div&gt;2. Entity extraction&lt;/div&gt;&lt;div&gt;3. Client facing APIs or System interface&lt;/div&gt;&lt;div&gt;4. Data flow (only if data processing intensive question)&lt;/div&gt;&lt;div&gt;5. Basic HLD that satisfies functional requirements&lt;/div&gt;&lt;div&gt;6. Deep dive into non functional requirements&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="588" x="51.5" y="93" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Requirement Clarification" vertex="1">
          <mxGeometry height="30" width="159" x="-233" y="209" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Functional" vertex="1">
          <mxGeometry height="30" width="60" x="-226" y="305" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. Users are able to create posts" vertex="1">
          <mxGeometry height="30" width="198" x="-237" y="354" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="3. Users are able to search for posts by keyword. Further, the posts can be sorted based on the timestamps or number of likes.&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="405" x="-233" y="427" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Non-functional requirements" vertex="1">
          <mxGeometry height="30" width="174" x="-246" y="708" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. CAP Theorem: AP System. Availability &amp;gt;&amp;gt; Consistency. Expectation to be eventually consistent within 1 min" vertex="1">
          <mxGeometry height="30" width="624" x="-252" y="757" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. Low latency post search ( &amp;lt; 500 ms) - Human being perceive as real time in less than this number" vertex="1">
          <mxGeometry height="30" width="536" x="-237" y="803" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="3. High throughput (See below)" vertex="1">
          <mxGeometry height="30" width="225" x="-264" y="845" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Note: You can&#39;t use ElasticSearch, PostGres Full Text or other off the shelf search functionality" vertex="1">
          <mxGeometry height="30" width="516" x="-226" y="257" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. Users are able to like posts" vertex="1">
          <mxGeometry height="30" width="237" x="-268" y="384" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Out of scope functional requirements" vertex="1">
          <mxGeometry height="30" width="244" x="-240" y="488" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. Fuzzy Search (a search technique that finds results even when the user’s query does not perfectly match the data)" vertex="1">
          <mxGeometry height="30" width="769" x="-284" y="554" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. Filtering results" vertex="1">
          <mxGeometry height="30" width="149" x="-243.5" y="522" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="3. Personalization of search results - By the way, if this was in scope, it would have introduced complexity since we wouldn&#39;t be able to cache the search results since they would be specific to a user." vertex="1">
          <mxGeometry height="30" width="616.5" x="-213" y="596" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-18" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;4. High recall, all of the posts (Out of all the truly relevant items in the entire database, how many did the search engine actually find and return?)&lt;/span&gt;" vertex="1">
          <mxGeometry height="36" width="881" x="-240" y="887" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-19" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;5. High availability&lt;/span&gt;" vertex="1">
          <mxGeometry height="36" width="162" x="-240" y="930" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Back of envelope estimation - usually not a good idea to do it, if it&#39;s not going to influence the design. However, in this case we are doing it, since we need to understand the read to write ratio and the storage requirement of the system." vertex="1">
          <mxGeometry height="99" width="482" x="-246" y="1008" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Intuition or instinct we initially have is: this is going to be a read heavy system since the question says &quot;search&quot; system&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="688" x="-268" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-22" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Users of the system: 1 Billion" vertex="1">
          <mxGeometry height="30" width="192" x="-257" y="1177" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-23" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Writes: (assumption 1 person posts while 100 others like it)" vertex="1">
          <mxGeometry height="30" width="407.5" x="-281" y="1232" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-24" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Posts: 1B/100K = 10 K posts/sec&lt;div&gt;Likes: 10B/100K = 100 K likes/sec&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="254" x="-240" y="1274" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-25" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Reads:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Searches: 1B/100K = 10 K Search/ sec&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="496" x="-352" y="1362" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-26" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="So, this proved to be a write heavy system than a read heavy one" vertex="1">
          <mxGeometry height="30" width="378" x="-252" y="1459" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-27" edge="1" parent="1" source="GXhtB-WlkQ6-UquPLxNR-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;innerLoopWaypoints=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="GXhtB-WlkQ6-UquPLxNR-26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Storage: assumption: average post size is 1 KB&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Number of Posts: 1 B * 365 * 10 years = 3.6 TB&lt;/div&gt;&lt;div&gt;Storage: 3.6 TB * 1KB = 3.6 PB&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;We&#39;ll see later in the design, how this storage can be optimized - do we really need to store all the posts for Search&lt;/div&gt;" vertex="1">
          <mxGeometry height="86" width="290" x="-240" y="1543" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Entities" vertex="1">
          <mxGeometry height="30" width="60" x="-248" y="1684" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-31" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="User&lt;div&gt;Post&lt;/div&gt;&lt;div&gt;Like&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="-246" y="1734" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-32" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="API" vertex="1">
          <mxGeometry height="30" width="60" x="-248" y="1801" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-36" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="POST /posts&lt;div&gt;User ID from authentication header JWT/Session&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Request Body: Content&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Response: PostID&lt;/div&gt;" vertex="1">
          <mxGeometry height="186" width="176" x="-254" y="1856" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="POST /likes&lt;div&gt;User ID from authentication header JWT/Session&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Request Body: postID&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Response: success&lt;/div&gt;" vertex="1">
          <mxGeometry height="186" width="176" x="81" y="1856" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-38" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="GET /search?keyword={keyword}&amp;amp;sortBy={criteria}&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Response: List &amp;lt;Post&amp;gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="186" width="176" x="449" y="1871" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-39" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="High level design that satisifes functional requirements" vertex="1">
          <mxGeometry height="30" width="439" x="-321" y="2046" as="geometry" />
        </mxCell>
        <mxCell id="GXhtB-WlkQ6-UquPLxNR-40" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Basic design principle to be kept in mind: Keep different services for different functionalities, especially if one operation is read intensive and the other is write intensive. This allows us to scale the services (read and write operations) independently" vertex="1">
          <mxGeometry height="61" width="578.5" x="-254" y="2104" as="geometry" />
        </mxCell>
