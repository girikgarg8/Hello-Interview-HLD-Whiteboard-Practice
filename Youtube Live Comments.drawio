        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-19" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="API to fetch comments in paginated fashion would need persistent connection like SSE or WebSocket because of latency requirements" vertex="1">
          <mxGeometry height="30" width="336" x="-187" y="1199" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Let&#39;s evaluate the tradeoffs for both the approaches - the general decision tree as well as specifically in the context of this problem&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="408" x="-196" y="1298" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-22" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Latency sensitive requirement?" vertex="1">
