        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-63" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Comment&amp;nbsp;&lt;div&gt;- Id&lt;/div&gt;&lt;div&gt;- UserId&lt;/div&gt;&lt;div&gt;- VideoId&lt;/div&gt;&lt;div&gt;- Content&lt;/div&gt;&lt;div&gt;...other metadata&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="397" y="3138" as="geometry" />
