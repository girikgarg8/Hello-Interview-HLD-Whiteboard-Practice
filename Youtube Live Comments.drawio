        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-62" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="(maintain mapping of video to list of servers)" vertex="1">
