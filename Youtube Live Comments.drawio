          <mxGeometry height="60" width="120" x="274" y="1648" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-35" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="339" y="1711" as="sourcePoint" />
            <mxPoint x="389" y="1783.9" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-36" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Yes" vertex="1">
          <mxGeometry height="30" width="60" x="358" y="1726" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-37" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Use WebRTC" vertex="1">
          <mxGeometry height="60" width="120" x="398" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-38" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="339.77" y="1711" as="sourcePoint" />
            <mxPoint x="289.23" y="1779.01" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-39" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="No" vertex="1">
          <mxGeometry height="30" width="60" x="262" y="1722" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-40" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Use WebSockets" vertex="1">
          <mxGeometry height="60" width="120" x="218" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-41" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="In the context of our problem, the ratio of comment creation to reads/streams would be like 1:1000 or 1:2000&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Hence, there is no need for &quot;frequent&quot; bidirectional communication and an SSE would do fine&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Also, websockets introduce ton of complexity such as :&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1.&amp;nbsp; All intermediate layers like Gateway, proxy layers etc need to support Websockets&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. Websockets are also resource intensive compared to SSE. There is no browser built-in support for reconnection if Websocket goes down&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;In the aftermath of these facts, we&#39;ll go with a REST API for create comments and SSE based API for comments streaming.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Since SSE/Websocket don&#39;t have a formal API contract unlike REST APIs, we can jutst indicate it with arrows in HLD diagram.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="609" x="-486" y="1955" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-42" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Attaching below a comparison of SSE and WebSocket as explained in the video:" vertex="1">
          <mxGeometry height="30" width="234" x="-286" y="2295" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-43" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="SSE" vertex="1">
          <mxGeometry height="30" width="60" x="-471" y="2397" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-44" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Websocket" vertex="1">
          <mxGeometry height="30" width="60" x="-28" y="2401" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-46" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="- Unidirectiona&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;l&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- over HTTP&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- Built in browser support for reconnection&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- Just looks like a long running HTTP request&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- HTTP headers to indicate we&#39;ll be sending chunks&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="144" width="214" x="-544" y="2470" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-47" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="- Bidirectional&lt;div&gt;- Its own protocol (not HTTP)&lt;/div&gt;&lt;div&gt;- All infra need to support upgrading from HTTP to websocket&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Load balancers, proxies, firewalss - all need to negotiate this upgrade&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="401" x="-202" y="2499" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-48" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Some other design decisions and their rationale:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. Separate out comment CRUD service from the comment broadcast service: At the scale of 100 Million Users, a single service doing both CRUD operations on DB as well as handling SSE connections.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Thus, to have separation of concerns and better scalability, this design decision is taken&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="308" x="-542" y="2719" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-50" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. Maintain Redis Cache to store video -&amp;gt; [list of servers] mapping and each server will maintain internally maintain in-memory&amp;nbsp;&lt;div&gt;mapping of video -&amp;gt; [list of sse connections] over which update to be sent&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Reason: as we horizontally scale the chat broadcast servers, we need to maintain mapping of which all servers have active SSE connections for a given video.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="362" x="-544" y="2958" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-52" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="HLD:" vertex="1">
          <mxGeometry height="30" width="267" x="-642" y="3083" as="geometry" />
        </mxCell>
