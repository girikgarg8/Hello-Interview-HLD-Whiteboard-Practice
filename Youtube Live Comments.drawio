          <mxGeometry height="60" width="120" x="204" y="1514" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-29" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="251.77" y="1574" as="sourcePoint" />
            <mxPoint x="201.23" y="1642.01" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-30" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="No" vertex="1">
          <mxGeometry height="30" width="60" x="174" y="1585" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-31" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Use Server Side Events (SSE)" vertex="1">
          <mxGeometry height="30" width="60" x="127" y="1681" as="geometry" />
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-32" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="250.23" y="1575.12" as="sourcePoint" />
            <mxPoint x="299.23" y="1647.12" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="eJ3RLoxxL0zo8U_XuLCM-33" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Yes" vertex="1">
          <mxGeometry height="30" width="60" x="267" y="1591" as="geometry" />
        </mxCell>
