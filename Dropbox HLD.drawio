        <mxCell id="-ytKBwrGRmqnR_m710Oe-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. Low latency uploads and downloads of files (we cannot quantify since files size is variable, hence going with &#39;as low as possible&#39;)" vertex="1">
