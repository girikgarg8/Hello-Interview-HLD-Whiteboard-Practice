        <mxCell id="-ytKBwrGRmqnR_m710Oe-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="3. Ability to support large files (upto 50 GB) with resumable uploads&amp;nbsp;" vertex="1">
