        <mxCell id="-ytKBwrGRmqnR_m710Oe-18" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="• File Metadata&amp;nbsp;&lt;div&gt;-&amp;nbsp; Name&lt;/div&gt;&lt;div&gt;- Content&amp;nbsp;&lt;/div&gt;&lt;div&gt;- List of Chunks&lt;/div&gt;&lt;div&gt;....other metadata)&lt;/div&gt;" vertex="1">
