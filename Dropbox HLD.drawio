        <mxCell id="-ytKBwrGRmqnR_m710Oe-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. CAP theorem: AP system (eventually consistent is fine)" vertex="1">
