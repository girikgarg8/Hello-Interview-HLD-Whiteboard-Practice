          <mxGeometry height="60" width="120" x="79" y="3114" as="geometry" />
        </mxCell>
        <mxCell id="I4sKmwTz25wvMcoeHdur-40" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Write Service&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(horizontally scalable)&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="75" y="3367" as="geometry" />
        </mxCell>
        <mxCell id="I4sKmwTz25wvMcoeHdur-41" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;aspect=fixed;" value="Redis" vertex="1">
          <mxGeometry height="80" width="80" x="344" y="3108" as="geometry" />
        </mxCell>
        <mxCell id="I4sKmwTz25wvMcoeHdur-42" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;aspect=fixed;" value="DB" vertex="1">
