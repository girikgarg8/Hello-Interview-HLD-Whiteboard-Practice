<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="J9BQvCHIYIp7Ru_l7RV7">
    <mxGraphModel dx="1525" dy="642" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="wJZm29l0_nlpAetehJ7I-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Hello Interview Delivery Framework" vertex="1">
          <mxGeometry height="30" width="319" x="212" y="57" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="1. Requirement Gathering (Functional and non functional)&lt;div&gt;2. Entity extraction&lt;/div&gt;&lt;div&gt;3. Client facing APIs or System interface&lt;/div&gt;&lt;div&gt;4. Data flow (only if data processing intensive question)&lt;/div&gt;&lt;div&gt;5. Basic HLD that satisfies functional requirements&lt;/div&gt;&lt;div&gt;6. Deep dive into non functional requirements&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="588" x="90" y="119" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Requirement Gathering" vertex="1">
          <mxGeometry height="30" width="159" x="87" y="258" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Functional" vertex="1">
          <mxGeometry height="30" width="60" x="102" y="300" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. Given a set of starting/seed URLs, the crawler should be able to extract and parse contents of each of those webpages. And save them in some persistent storage to train LLMs&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="692" x="93" y="347" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. The system should be able to crawl other URLs which are found on a given webpage" vertex="1">
          <mxGeometry height="30" width="692" x="-14" y="377" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Non functional requirements" vertex="1">
          <mxGeometry height="30" width="178" x="87" y="421" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. Scale to crawl around 10 billion URLs, and average size of each would be around 2-3 MB. The task should be completed in 4-5 days&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="669" x="93" y="465" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. Politeness - if a domain has robots.txt with some internal URLs or rate limiting or restrictions on user agent etc, those should be respected" vertex="1">
          <mxGeometry height="30" width="638" x="87" y="509" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="3. Handle retries on errors like URL not being available intermittently due to 5xx or 429 issues etc" vertex="1">
          <mxGeometry height="30" width="638" x="40" y="559" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="4. Have dead letter queue mechanism in place, in case URL is not visitable even after multiple attempts&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="638" x="58" y="609" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="5. Not crawl the same URL multiple times as well as skip duplicate pages having exactly same content" vertex="1">
          <mxGeometry height="30" width="571" x="93" y="647" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Entities" vertex="1">
          <mxGeometry height="30" width="60" x="98" y="738" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. Domain (google.com)" vertex="1">
          <mxGeometry height="30" width="192" x="68" y="779" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. URL (google.com/maps), a given domain can have multiple URLs" vertex="1">
          <mxGeometry height="30" width="198" x="96" y="820" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="3. Raw HTML content of the URL webpage" vertex="1">
          <mxGeometry height="30" width="198" x="96" y="878" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-18" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="4. Extracted information from HTML content for each webpage" vertex="1">
          <mxGeometry height="30" width="198" x="102" y="923" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-19" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="APIs" vertex="1">
          <mxGeometry height="30" width="60" x="102" y="1031" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="No customer facing APIs, the seed/starting URLs will be pushed to frontier queue" vertex="1">
          <mxGeometry height="30" width="298" x="102" y="1064" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Database schema required for S3 blob storage can be discussed during HLD phase" vertex="1">
          <mxGeometry height="30" width="378" x="98" y="969" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-22" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Data flow" vertex="1">
          <mxGeometry height="30" width="60" x="110" y="1124" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-23" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Input: Set of seed/starting URLs for crawling" vertex="1">
          <mxGeometry height="30" width="290" x="84" y="1154" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-24" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; background-color: rgb(255, 255, 255); display: inline !important;&quot;&gt;Output: Extracted contents of each of the URLs in a persistent storage like S3, which can be used to train LLMs&amp;nbsp;&lt;/span&gt;" vertex="1">
          <mxGeometry height="36" width="263" x="110" y="1189" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-25" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="How is the input data going to be converted to required output data ?" vertex="1">
          <mxGeometry height="30" width="313" x="93" y="1285" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Describing high level data flow, which includes even the deep dives (non functional requirements too)" vertex="1">
          <mxGeometry height="30" width="476" x="90" y="1348" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. The initial set of seed URLs will be pushed to a Kafka topic called frontier queue (Why Kafka topic? To allow fan out among multiple crawler instances and allow for higher parallelism, since we have to crawl ~10B pages in 1 day)" vertex="1">
          <mxGeometry height="30" width="617" x="102" y="1428" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. The crawler instance subscribed to one or more partitions of this Kafka topic.&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Extract the domain from URL. Check in Redis Cache, Metadata DB and API requests (in that order) if robots.txt exists for that domain. Compare if any path rule or user agent rule preventing crawling the URL. If yes, skip this URL.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Do the DNS resolution of the endpoint (check for cache hit first in Redis to save Route53 cost, if it&#39;s cache miss, then do the hierarchial DNS query as usual)&lt;br&gt;&lt;br&gt;Two possible outcomes:&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2.1 . Successful extraction: Compute hash(raw HTML) and check with bloom filter and metadata DB (in that order) if it exists already. If it does, abandon processing there. Proceed with next steps if it doesn&#39;t.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Store the hash(rawHtml) into metadata DB so that webpages with same content can be avoided. [why not parser? this is the responsibility of crawler]&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Store the raw HTML contents as an S3 object, create metadata DB entry for URL along with the S3 link. Push the S3 link reference into a parsing queue. (Why not push the extracted HTML blob directly into the parsing queue? Because each webpage might be upto 2MB in size and with a scale of crawling 10B URLs, it would take lot of memory. Better option is to push the S3 link into the parsing queue, the parser service can download the blob and do the parsing)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="154" width="617" x="19.5" y="1618" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-30" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2.2 Failed to extract due to 429/5xx or other issues: Check failedCount for this URL from metadata DB.&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Two scenarios:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2.2.1 If failedCount is already equal to max failure threshold, push it to dead letter queue since we have exhausted all attempts&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2.2.2 If failedCount &amp;lt; max failure threshold, increment&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;failedCount in the DB and then push it to retry queue (Kafka topic) so that it can be retried at a later stage&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="15" width="559" x="62" y="1932" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-31" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="3. The parsing service/workers are going to consume the S3 links from the parsing queue, download the raw HTML blob from S3. Parsing phase will begin which will result into the following outcomes:&lt;br&gt;&lt;br&gt;&lt;br&gt;3.1&amp;nbsp; &amp;nbsp;The text content extracted will be stored in S3 as a blob object, and the metadata DB will also be updated to include the S3 link&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3.2 Any new URLs from the current webpage, should be looked up in bloom filter &amp;gt; Redis Cache &amp;gt; metadata DB with index on URL (in that order) to check if the new URL has already been visited or not. Only if it&#39;s not been visited earlier, push this new URL to frontier queue (Kafka topic) so they can be crawled next.&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="674" x="26" y="2105" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-32" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="HLD (including the deep dives)" vertex="1">
          <mxGeometry height="30" width="200" x="15" y="2210" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-33" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Frontier Queue" vertex="1">
          <mxGeometry height="60" width="120" x="-5" y="2364" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-34" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Retry Queue" vertex="1">
          <mxGeometry height="60" width="120" x="-5" y="2482" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-35" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Dead Letter Queue" vertex="1">
          <mxGeometry height="60" width="120" x="-8" y="2600" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-36" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="60" width="120" x="244" y="2463" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Crawler" vertex="1">
          <mxGeometry height="30" width="60" x="274" y="2482" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-38" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Redis Cache" vertex="1">
          <mxGeometry height="36" width="73" x="246" y="2364" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-39" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="wJZm29l0_nlpAetehJ7I-38" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="295.44" y="2461.33" as="sourcePoint" />
            <mxPoint x="339" y="2416" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-40" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="DNS, robots.txt" vertex="1">
          <mxGeometry height="30" width="60" x="265" y="2417" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-41" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;entryX=0.424;entryY=0.986;entryDx=0;entryDy=0;entryPerimeter=0;" target="wJZm29l0_nlpAetehJ7I-42" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="319.89" y="2461.33" as="sourcePoint" />
            <mxPoint x="396.56" y="2406.89" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-42" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="URL endpoint" vertex="1">
          <mxGeometry height="39" width="120" x="379" y="2364" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-43" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="GET request" vertex="1">
          <mxGeometry height="30" width="101.5" x="374.5" y="2421" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-44" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="S3 Blob Storage" vertex="1">
          <mxGeometry height="60" width="120" x="493" y="2540" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-45" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;aspect=fixed;" value="Metadata DB" vertex="1">
          <mxGeometry height="102" width="102" x="502" y="2670" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-46" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Domain&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- link (PK)&lt;/div&gt;&lt;div&gt;- robots.txt&lt;/div&gt;&lt;div&gt;- lastCrawlTime&lt;/div&gt;&lt;div&gt;- crawlDelay (from robots.txt)&lt;/div&gt;&lt;div&gt;- ...metadata like last modified, created etc&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;URL&lt;/div&gt;&lt;div&gt;- link (PK)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- rawHTMLS3Link&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- extractedContentS3Link&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- failedCount&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- hash(HTML) (index)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;- ...metadata like last modified, created etc&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="209" width="210" x="669" y="2660" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-49" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Parsing Queue" vertex="1">
          <mxGeometry height="60" width="120" x="244" y="2598" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-50" edge="1" parent="1" source="wJZm29l0_nlpAetehJ7I-33" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="wJZm29l0_nlpAetehJ7I-36" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="389" y="2635" as="sourcePoint" />
            <mxPoint x="439" y="2585" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-51" edge="1" parent="1" source="wJZm29l0_nlpAetehJ7I-34" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" target="wJZm29l0_nlpAetehJ7I-36" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="389" y="2635" as="sourcePoint" />
            <mxPoint x="439" y="2585" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-52" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Parser" vertex="1">
          <mxGeometry height="60" width="120" x="246" y="2716" as="geometry" />
        </mxCell>
        <mxCell id="wJZm29l0_nlpAetehJ7I-56" edge="1" parent="1" source="wJZm29l0_nlpAetehJ7I-36" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" value="">
