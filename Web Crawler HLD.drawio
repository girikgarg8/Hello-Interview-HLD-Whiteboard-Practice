        <mxCell id="wJZm29l0_nlpAetehJ7I-65" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="New URLs" vertex="1">
